# Configuration du worker (apps/worker) — voir packages/core/src/config.ts
# En production ces variables sont posées par infra/deploy-worker.sh ;
# ce fichier sert au lancement local : node --env-file=.env apps/worker/dist/server.js

# Projet GCP (obligatoire)
GOOGLE_CLOUD_PROJECT=looker-studio-458310
REGION=us-central1

# Bucket GCS des scans (créé par infra/setup.sh)
GCS_BUCKET=looker-studio-458310-fataawa-scans

# Dossier Drive racine contenant un sous-dossier par livre
DRIVE_ROOT_FOLDER_ID=
# Noms des sous-dossiers par livre (conventions héritées du GAS)
DRIVE_INBOX_NAME=A TRAITER
DRIVE_DONE_NAME=TRAITES

# Clé API Gemini — en production elle vient de Secret Manager, jamais d'un fichier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# File Cloud Tasks + identité OIDC des tâches
OCR_QUEUE=ocr
WORKER_URL=https://pending.invalid
TASKS_SA_EMAIL=sa-fataawa-worker@looker-studio-458310.iam.gserviceaccount.com

# Réglages pipeline
MAX_OCR_ATTEMPTS=3
INGEST_BATCH=100
STUCK_AFTER_MINUTES=30
